<%- include('partials/head') %>

<div class="mb-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-800">Antrean</h1>
  <p class="text-sm text-gray-400 mt-1"><%= antrean.length %> orang dalam antrean · perkiraan tunggu <%= estimasi %> menit</p>
</div>

<div class="grid md:grid-cols-3 gap-8 items-start">
  <section class="md:col-span-2 space-y-3">
    <% if (antrean.length === 0) { %>
      <div class="rounded-xl border border-dashed border-gray-300 p-10 text-center text-sm text-gray-400">Belum ada antrean. Silakan datang langsung.</div>
    <% } %>

    <% antrean.forEach((a) => { %>
      <div class="rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-14 h-14 shrink-0 rounded-lg bg-gray-100 border border-gray-200 text-gray-700 font-bold flex items-center justify-center"><%= a.nomor %></div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-gray-800 truncate"><%= a.nama %></p>
          <p class="text-sm text-gray-400 truncate"><%= a.produk.nama %> · daftar <%= fmt.jam(a.waktuDaftar) %></p>
        </div>
        <% if (a.status === 'menunggu') { %>
          <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">Menunggu</span>
          <form method="POST" action="/antrean/<%= a.id %>/status">
            <input type="hidden" name="status" value="dilayani">
            <button class="text-sm border border-gray-300 text-gray-700 px-3.5 py-1.5 rounded-lg hover:bg-gray-50 transition-colors">Mulai</button>
          </form>
        <% } else { %>
          <span class="text-xs px-2.5 py-1 rounded-full bg-gray-700 text-white">Dilayani</span>
          <form method="POST" action="/antrean/<%= a.id %>/status">
            <input type="hidden" name="status" value="selesai">
            <button class="text-sm bg-gray-800 text-white px-3.5 py-1.5 rounded-lg hover:bg-gray-700 transition-colors">Selesai</button>
          </form>
        <% } %>
        <form method="POST" action="/antrean/<%= a.id %>/hapus" onsubmit="return confirm('Hapus antrean ini?');">
            <button class="text-sm text-gray-400 hover:text-gray-800 px-2 py-1.5 transition-colors" title="Hapus">Hapus</button>
          </form>
      </div>
    <% }) %>
  </section>

  <aside class="rounded-xl border border-gray-200 p-6">
    <h2 class="font-bold text-gray-800 mb-5">Ambil nomor antrean</h2>
    <form method="POST" action="/antrean" class="space-y-4">
      <div>
        <label class="block text-sm text-gray-500 mb-1.5" for="nama">Nama</label>
        <input id="nama" name="nama" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-200 focus:border-gray-500">
      </div>
      <div>
        <label class="block text-sm text-gray-500 mb-1.5" for="produkId">Layanan</label>
        <select id="produkId" name="produkId" required class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-200 focus:border-gray-500">
          <% produk.filter((p) => p.kategori === 'Layanan').forEach((p) => { %>
            <option value="<%= p.id %>"><%= p.nama %> – <%= fmt.rupiah(p.harga) %></option>
          <% }) %>
        </select>
      </div>
      <button class="w-full bg-gray-800 hover:bg-gray-700 text-white text-sm font-semibold py-2.5 rounded-lg transition-colors">Ambil antrean</button>
    </form>
  </aside>
</div>

<%- include('partials/foot') %>
